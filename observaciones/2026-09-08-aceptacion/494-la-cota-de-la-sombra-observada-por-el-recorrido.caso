            "", false, false, false, false, false, false, "200-corrida-sin-ninguna-corrida", "simulacion.corrida_reproducible", true, "observada", true
            "", false, false, false, false, false, false, "201-presupuesto-sin-ninguna-corrida", "simulacion.no_se_agoto_el_presupuesto", true, "observada", true
