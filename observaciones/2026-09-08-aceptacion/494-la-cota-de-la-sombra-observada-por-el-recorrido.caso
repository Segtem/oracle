            "", false, false, false, false, false, false, "301-simulador-que-ignora-la-semilla", "simulacion.corrida_reproducible", true, "construida", true
            "", false, true, false, false, true, false, "302-corridas-reproducibles", "simulacion.corrida_reproducible", true, "construida", true
