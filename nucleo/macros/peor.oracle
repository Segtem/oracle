# La invocación repite las cláusulas variables de esta plantilla.
defmacro peor(id, relacion, alias, expresion, tolerancia, porque, segun, ambito, alcance):
    medida $id:
        de $relacion $alias
        donde $expresion > $tolerancia
        resumen max($expresion)
        umbral <= $tolerancia segun $segun porque $porque
        ambito $ambito
        alcance $alcance
