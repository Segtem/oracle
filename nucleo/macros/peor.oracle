# `segun` va después de `porque` para no cambiar el significado posicional de las invocaciones
# existentes; no hay default. La prosa puede ser "", pero la etiqueta del origen siempre se decide.
defmacro peor(id, relacion, alias, expresion, tolerancia, porque, segun, alcance):
    medida $id:
        de $relacion $alias
        donde $expresion > $tolerancia
        resumen max($expresion)
        umbral <= $tolerancia segun $segun porque $porque
        alcance $alcance
