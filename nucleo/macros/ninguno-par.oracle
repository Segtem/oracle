# `segun` y `ambito` van después de `porque` para no cambiar el significado posicional de las
# invocaciones existentes; no hay default. La prosa puede ser "", pero la etiqueta del origen y el
# ámbito siempre se deciden.
defmacro ninguno-par(id, relacion, aliasA, aliasB, predicado, porque, segun, ambito, alcance):
    guarda $aliasA != $aliasB "los dos alias de «ninguno-par» tienen que ser distintos"
    medida $id:
        de $relacion $aliasA
        unir $relacion $aliasB
        donde $predicado
        resumen contar(1)
        umbral <= 0 segun $segun porque $porque
        ambito $ambito
        alcance $alcance
