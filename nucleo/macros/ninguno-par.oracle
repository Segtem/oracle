defmacro ninguno-par(id, relacion, aliasA, aliasB, predicado, porque, alcance):
    guarda $aliasA != $aliasB "los dos alias de «ninguno-par» tienen que ser distintos"
    medida $id:
        de $relacion $aliasA
        unir $relacion $aliasB
        donde $predicado
        resumen contar(1)
        umbral <= 0 porque $porque
        alcance $alcance
