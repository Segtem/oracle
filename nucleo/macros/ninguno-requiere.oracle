# La invocación repite las cláusulas variables de esta plantilla.
defmacro ninguno-requiere(id, relacion, alias, predicado, porque, segun, ambito, alcance):
    medida $id:
        de $relacion $alias
        donde $predicado
        resumen contar(1)
        umbral <= 0 segun $segun porque $porque
        requiere $relacion
        ambito $ambito
        alcance $alcance
