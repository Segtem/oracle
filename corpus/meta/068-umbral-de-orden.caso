caso 068-umbral-de-orden:
    fecha: "2026-08-24"
    origen:
        repo: "Segtem/oracle"
        commit: "sin-commit"
    titulo: "Los umbrales de orden no son igualdad exacta"
    etiqueta: verde_correcto
    sintoma:
        Dos medidas usan comparadores de orden. La regla debe dejarlas pasar y no confundir una cota con una igualdad exacta.
    como_se_detecto: observacion
    medida: meta.ningun_umbral_de_igualdad
    evidencia:
        medida: id, comparador
            "dominio.cota_superior", "<="
            "dominio.cota_inferior", ">"
    leccion:
        El caso verde mata la mutación que quita el filtro: contar la relación completa ya no sería cero.
