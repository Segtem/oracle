caso 021-impacto-fantasma:
    fecha: "2026-09-25"
    origen:
        repo: "ejemplo/batalla-naval"
        commit: "sin-commit"
    procedencia: construida
    titulo: "impacto fantasma"
    etiqueta: falso_verde
    sintoma:
        El disparo se declara impacto sin barco rival en la casilla.
    como_se_detecto: persona
