{
    "name": "oracle-lenguaje",
    "displayName": "Oracle (metalenguaje de medidas)",
    "description": "Resaltado, diagnósticos y completado para .oracle, .caso, .relacion y .requisito",
    "publisher": "cs50-taller",
    "version": "1.2.2",
    "engines": {
        "vscode": "^1.75.0"
    },
    "main": "./extension.js",
    "activationEvents": [
        "onLanguage:oracle"
    ],
    "contributes": {
        "languages": [
            {
                "id": "oracle",
                "aliases": [
                    "Oracle"
                ],
                "extensions": [
                    ".oracle",
                    ".caso",
                    ".relacion",
                    ".requisito"
                ],
                "configuration": "./lenguaje.json"
            }
        ],
        "grammars": [
            {
                "language": "oracle",
                "scopeName": "source.oracle",
                "path": "./oracle.tmLanguage.json"
            }
        ],
        "configuration": {
            "title": "Oracle",
            "properties": {
                "oracle.confiarEscalares": {
                    "type": "boolean",
                    "default": false,
                    "scope": "machine",
                    "description": "Autoriza las escalares.py del proyecto al iniciar el servidor Oracle. Sólo se fija en la configuración del usuario: un proyecto no puede encenderla desde su .vscode/settings.json."
                }
            }
        }
    }
}
