requisito cli_validate.pie_next_steps:
    texto "Invalid results SHALL include a Next steps footer in human-readable output"
    fuente "openspec/specs/cli-validate/spec.md"
    medido_por openspec.pie_trae_dos_a_tres_pasos, openspec.cambio_invalido_muestra_el_pie
    sin_medir "que las viñetas estén dirigidas a los errores más frecuentes es un juicio"
