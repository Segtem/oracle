caso 005-columna-desbordada:
    fecha: "2026-09-21"
    origen:
        repo: "Segtem/oracle/ejemplo/primer-valor"
        commit: "sin-commit"
    procedencia: construida
    titulo: "Columna justo por encima del tablero"
    etiqueta: falso_verde
    sintoma:
        Columna justo por encima del tablero; la medida debe rechazar esta evidencia.
    como_se_detecto: mutacion
    medida: colocacion.dentro_del_tablero
    evidencia:
        celda_ocupada: barco, fila, columna
            "borde", 5, 10
    leccion:
        Cada borde y la falta de evidencia deben quedar fijados por el corpus.
